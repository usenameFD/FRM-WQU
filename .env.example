# FRED API key (optional). Free signup: https://fred.stlouisfed.org/docs/api/api_key.html
# If unset, FredLoader falls back to FRED's keyless public CSV download endpoint.
FRED_API_KEY=

# EIA Open Data API key (optional). Free signup: https://www.eia.gov/opendata/register.php
# If unset, EiaLoader is skipped and a warning is logged.
EIA_API_KEY=
